      "y": 9,
      "w": 10,
      "h": 6,
      "mirrored": false,
      "color": "cyan"
    },
    {
      "id": "doc3_p2",
      "label": "技术栈",
      "desc": "纯 JS + HTML5 + CSS3 + Canvas 2D + SVG + localStorage。无框架、无构建步骤; 运行时唯一外部请求是 CDN 字体。",
      "x": 55,
      "y": 9,
      "w": 10,
      "h": 6,
      "mirrored": false,
      "color": "cyan"
    },
    {
