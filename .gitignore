# ══ 通用规则 ══
# 本段需与公开发布库的 .gitignore 保持相同内容。

# 依赖与缓存
node_modules/
.npm-cache/
npm-debug.log*

# 操作系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# test/package-lock.json 需入库：CI 用 npm ci 依赖锁文件复现安装

# GUI 测试产物
test/shots/
test/shots-*/

# 压测存档由脚本生成，不入库：双击 test/samples/gen-fullmesh.cmd
test/samples/weave_250_fullmesh.json

# 一次性重构工具；weave-parse.js 是 check-structure.js 的运行时依赖，保留入库
test/refactor/*
!test/refactor/weave-parse.js
